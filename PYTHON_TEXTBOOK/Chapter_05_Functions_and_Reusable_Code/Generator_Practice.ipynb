   "source": [
    "# **Generators in python**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "def36d20",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Starting Machine...\n",
      "1\n"
     ]
    }
   ],
   "source": [
    "def count_to_three():\n",
    "    print(\"Starting Machine...\")\n",
    "    yield 1\n",
    "    yield 2\n",
    "    yield 3\n",
    "gen = count_to_three()  # Creates the generator object\n",
    "\n",
    "print(next(gen))"
   ]
  },
